<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Merged with the build-setting-generated Info.plist (GENERATE_INFOPLIST_FILE
	     stays on). Only keys Xcode has no INFOPLIST_KEY_* setting for belong here;
	     NSAudioCaptureUsageDescription is one, and without it the system audio
	     tap's permission prompt has nothing to show. Lives in Config/, not
	     Transcriber/, so the folder-synchronized group can't bundle it. -->
	<key>NSAudioCaptureUsageDescription</key>
	<string>Transcriber can include audio playing on your Mac, such as the other side of a call, in a dictation.</string>
</dict>
</plist>
